{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CONSTITUTION.md", ".claude/rules/*.md"],
  "model": "replaceable/provider-model",
  "agent": {
    "planner": {"mode":"subagent","prompt":"{file:./.agentic/roles/planner.md}","permission":{"edit":"deny","bash":"deny","webfetch":"deny"}},
    "builder": {"mode":"subagent","prompt":"{file:./.agentic/roles/builder.md}","permission":{"edit":"allow","bash":"allow"}},
    "reviewer": {"mode":"primary","prompt":"{file:./.agentic/roles/reviewer.md}","permission":{"edit":"deny","bash":"deny","webfetch":"deny","external_directory":"allow"}}
  },
  "mcp": {"servers": {}}
}
