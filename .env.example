# Variables de entorno — gi-clinicadental (Sonría más)
#
# Copiar este archivo a `.env.local` (o `.env`) y completar con los
# valores reales. NUNCA commitear el archivo completado: `.gitignore`
# ya excluye `.env` y todas sus variantes, solo este `.env.example`
# queda versionado.
#
# Los valores reales de producción/preview viven exclusivamente en
# Vercel (Settings → Environment Variables), nunca en este repositorio,
# en documentación, en el historial de Git ni en logs o prompts de
# agentes (ver AGENTS.md, ítem 00-aprovisionamiento-entorno-vercel).

# --- SMTP (Ferozo, vía Nodemailer) -----------------------------------
# Servidor de correo saliente para notificar a la clínica y confirmar
# al paciente. Conexión TLS por el puerto 465 (ver AGENTS.md).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Dirección remitente que verán los destinatarios (debe ser un buzón
# válido del dominio de la clínica para no afectar entregabilidad).
SMTP_FROM=

# Buzón interno de la clínica que recibe la notificación de cada lead
# nuevo (no confundir con SMTP_FROM, que es el remitente).
LEADS_NOTIFICATION_EMAIL=

# --- Supabase ----------------------------------------------------------
# URL del proyecto Supabase. Prefijo NEXT_PUBLIC_: se expone al
# frontend/cliente, no es secreta.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (anon/public). También se expone al cliente; el acceso
# real de escritura queda restringido por RLS en la base de datos, no
# por mantener esta clave en secreto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de rol de servicio (service_role). ESTRICTAMENTE server-side:
# nunca debe llegar al frontend ni a un log. Bypassea RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---------------------------------------------------------------
# URL base del sitio para el entorno actual. Distinta en cada entorno
# de Vercel (Preview/Production); en desarrollo local:
SITE_URL=http://localhost:3000

# --- Protección antispam (POST /api/leads) --------------------------------
# Lista opcional de orígenes adicionales permitidos para POST /api/leads,
# separados por coma (ej. "https://sonriemascorrientes.com,http://localhost:3000").
# SITE_URL y https://${VERCEL_URL} (provisto automáticamente por Vercel
# en cada deployment) ya se consideran permitidos sin necesidad de
# listarlos acá. Dejar vacío si no hace falta ningún origen adicional.
ALLOWED_ORIGINS=

# --- Que NO va en este archivo ------------------------------------------
# El contenido publico del sitio -marca, telefono, WhatsApp, correo,
# direccion, horarios, redes, servicios y los datos variables de la
# politica de privacidad- vive en `config/clinic.json`, versionado y
# revisable en una PR. Aca van solo credenciales y configuracion de
# infraestructura.
#
# Las variables `NEXT_PUBLIC_*` llegan al navegador: ninguna puede
# contener un secreto. `SUPABASE_SERVICE_ROLE_KEY` en particular
# bypassea RLS por completo y es estrictamente server-side.
